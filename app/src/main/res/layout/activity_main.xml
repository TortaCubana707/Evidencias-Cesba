<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- HEADER CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/primary_cesba">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_name"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:textColor="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/sub_title"
                    android:textSize="14sp"
                    android:textColor="#D0E0F8"
                    android:layout_marginTop="2dp" />

                <!-- NIVEL 2: CONTADOR DE FOTOGRAFÍAS -->
                <TextView
                    android:id="@+id/txtContador"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Evidencias guardadas: 0"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:background="#20FFFFFF"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:layout_marginTop="10dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CAMERA / PHOTO PREVIEW CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/imgFoto"
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="#E8EAF0"
                    android:contentDescription="Fotografía de evidencia"
                    android:scaleType="centerCrop"
                    android:src="@android:drawable/ic_menu_gallery" />

                <!-- NIVEL 1 & 2: FECHA, HORA Y ESTADO -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="10dp"
                    android:padding="8dp"
                    android:background="#F0F4F8">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <!-- NIVEL 1: FECHA DE EVIDENCIA -->
                        <TextView
                            android:id="@+id/txtFecha"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Fecha: --/--/----"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />

                        <!-- NIVEL 1: HORA DE CAPTURA -->
                        <TextView
                            android:id="@+id/txtHora"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Hora: --:--:--"
                            android:textSize="13sp"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- NIVEL 2: ESTADO DE EVIDENCIAS -->
                    <TextView
                        android:id="@+id/txtEstado"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Estado: Sin fotografía capturada"
                        android:textSize="13sp"
                        android:textColor="@color/status_pending"
                        android:textStyle="italic"
                        android:layout_marginTop="4dp" />

                </LinearLayout>

                <!-- BOTONES DE FOTO (NIVEL 1: TOMAR OTRA FOTO / ELIMINAR FOTO) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/btnTomarFoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/tomar_foto"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/primary_cesba"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btnEliminarFoto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/eliminar_foto"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:backgroundTint="@color/delete_red"
                        android:layout_marginStart="4dp" />

                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- FORM CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/card_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/titulo_evidencia"
                    android:textStyle="bold"
                    android:textColor="@color/primary_cesba"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_titulo"
                    android:inputType="textCapSentences"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp"
                    android:background="@android:drawable/editbox_background" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/descripcion_evidencia"
                    android:textStyle="bold"
                    android:textColor="@color/primary_cesba"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/edtDescripcion"
                    android:layout_width="match_parent"
                    android:layout_height="90dp"
                    android:gravity="top"
                    android:hint="@string/hint_descripcion"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:background="@android:drawable/editbox_background" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTION BUTTONS CARD (NIVEL 3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- NIVEL 3: GUARDAR FOTOGRAFÍA / EVIDENCIA -->
            <Button
                android:id="@+id/btnGuardar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/guardar_evidencia"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/accent_orange"
                android:paddingVertical="12dp"
                android:layout_marginBottom="8dp" />

            <!-- NIVEL 3: COMPARTIR EVIDENCIAS -->
            <Button
                android:id="@+id/btnCompartir"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/compartir_evidencia"
                android:textStyle="bold"
                android:textColor="@color/primary_cesba"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginBottom="8dp" />

            <!-- NIVEL 3: GENERAR FICHA DE EVIDENCIAS -->
            <Button
                android:id="@+id/btnGenerarFicha"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/generar_ficha"
                android:textStyle="bold"
                android:textColor="@color/primary_cesba"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_marginBottom="8dp" />

            <!-- NIVEL 3: GALERÍA DE EVIDENCIAS -->
            <Button
                android:id="@+id/btnVerGaleria"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ver_galeria"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:backgroundTint="@color/primary_cesba"
                android:layout_marginBottom="16dp" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
